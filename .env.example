# =============================================================
# GeoRescue AI — Environment Variables Template
# =============================================================
# Copy this file to `.env` and fill in the values.
# NEVER commit the real `.env` file.
#
# On Windows PowerShell:
#     Copy-Item .env.example .env
#
# Then edit `.env` in VS Code.
# =============================================================

# --- Copernicus Data Space Ecosystem (CDSE) ---
# Required for live Sentinel-1 and Sentinel-2 downloads.
# Register free at: https://dataspace.copernicus.eu/
# After login, credentials are your CDSE account email + password.
# The application uses these to obtain OAuth tokens.
#
# If these are unset, live satellite search/download will be skipped
# and the application will clearly report that real satellite
# acquisition is unavailable. It will NOT substitute synthetic data.
CDSE_USERNAME=
CDSE_PASSWORD=

# --- CDSE token endpoint (do not change unless CDSE docs change) ---
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_STAC_URL=https://catalogue.dataspace.copernicus.eu/stac
CDSE_ODATA_URL=https://catalogue.dataspace.copernicus.eu/odata/v1

# --- ohsome API (historical OpenStreetMap) ---
# ohsome v2 requires a free API key. Register at https://account.heigit.org
# The key is sent as an authorization header.
# Docs: https://docs.ohsome.org/ohsome-api/v2/
# Endpoint used: https://api.heigit.org/ohsome-api/v2/extraction/features.parquet
OHSOME_BASE_URL=https://api.heigit.org/ohsome-api/v2
OHSOME_API_KEY=

# --- Copernicus DEM 30m (AWS Open Data) ---
# Public S3 bucket — no key required.
# Docs: https://registry.opendata.aws/copernicus-dem/
COPERNICUS_DEM_S3_BASE=https://copernicus-dem-30m.s3.eu-central-1.amazonaws.com/

# --- Optional: DeepSeek LLM for the situation-report copilot ---
# If unset, GeoRescue AI uses its deterministic report generator.
# The application NEVER sends credentials or personal data to the LLM.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Application runtime settings (optional overrides) ---
GEORESCUE_LOG_LEVEL=INFO
GEORESCUE_DATA_DIR=data
GEORESCUE_OUTPUT_DIR=outputs
GEORESCUE_REPORT_DIR=reports

# Maximum AOI area in square kilometres accepted for a single analysis.
GEORESCUE_MAX_AOI_SQKM=5000

# Default projected CRS fallback when AOI spans multiple UTM zones.
GEORESCUE_FALLBACK_PROJECTED_CRS=EPSG:3857

# --- Gemini (Google AI Studio, free tier, preferred) ---
# Register for a free key at https://aistudio.google.com
# No credit card required. Free tier: 15 requests/min, 1500/day.
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash

# Copilot mode: "auto" (use LLM if key set), "deterministic" (never call LLM), "llm" (require LLM)
GEORESCUE_COPILOT_MODE=auto